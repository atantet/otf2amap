# Template de configuration locale — copier en `.env` et remplir.
# Le fichier .env est listé dans .gitignore et ne doit JAMAIS être commité.
#
# Identifiants de la boîte Gmail de l'AMAP, pour la commande `mail2amap`
# (téléchargement des tableurs de distribution reçus par mail).
#
# Connexion en IMAP avec un « mot de passe d'application » Gmail (16 caractères,
# dédié et révocable), PAS le mot de passe principal du compte. Obtention :
#   1. Activer la validation en 2 étapes sur le compte Google
#      (https://myaccount.google.com/security)
#   2. Créer un mot de passe d'application
#      (https://myaccount.google.com/apppasswords)
#   3. Coller les 16 caractères (sans espaces) dans AMAP_IMAP_PASSWORD ci-dessous

AMAP_IMAP_HOST=imap.gmail.com
AMAP_IMAP_USER=adresse.amap@gmail.com
AMAP_IMAP_PASSWORD=
